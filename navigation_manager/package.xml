<?xml version="1.0"?>
<package format="3">
  <name>navigation_manager</name><version>1.0.0</version>
  <description>Action based navigation coordination and bounded recovery.</description>
  <maintainer email="rsandovr@gmail.com">pumas</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>actionlib_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>path_planner</depend>
  <depend>known_locations_interfaces</depend>
  <test_depend>ament_cmake_gtest</test_depend><test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend><test_depend>tf2_ros_py</test_depend>
  <test_depend>simple_move</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
