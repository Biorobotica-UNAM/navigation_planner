<launch>

  <!-- ================================================================== -->
  <!--                         Global Arguments                           -->
  <!-- ================================================================== -->

  <arg name="use_sim_time"                            default="false"/>
  <arg name="namespace_hardware"                      default="hardware"/>
  <arg name="namespace_nav"                           default="navigation"/>
  <arg name="use_namespace"                           default="true"/>
  <arg name="base_link_name"                          default="base_link"/>

  <!-- ===== Map files ===== -->
  <arg name="static_map_file"                         default="$(find-pkg-share navigation_start)/maps/maps/lab_2026/map.yaml"/>
  <arg name="prohibition_map_file"                    default="$(find-pkg-share navigation_start)/maps/prohibition_maps/lab_2026/map.yaml"/>

  <!-- ===== Sensor topics ===== -->
  <arg name="point_cloud_topic"                       default="/$(var namespace_hardware)/camera/points"/>
  <arg name="point_cloud_topic2"                      default="/$(var namespace_hardware)/camera/points"/>
  <arg name="laser_scan_topic"                        default="/$(var namespace_hardware)/base/scan"/>
  <arg name="cmd_vel_topic"                           default="/$(var namespace_hardware)/base/cmd_vel"/>

  <!-- ===== Sensor toggles ===== -->
  <arg name="use_lidar"                               default="True"/>
  <arg name="use_point_cloud"                         default="True"/>
  <arg name="use_pot_fields"                          default="True"/>

  <!-- Physical geometry and independent planning/sensor margins. -->
  <!-- HSR base_v2 + bumper envelope: 0.228 m, rounded outward. -->
  <arg name="robot_radius"                            default="0.23"/>
  <arg name="start_recovery_margin" default="0.05"/>
  <arg name="start_recovery_search_radius" default="0.60"/>
  <arg name="near_goal_extra_margin" default="0.10"/>
  <arg name="near_goal_min_progress" default="0.90"/>
  <arg name="final_position_settle_sec" default="0.30"/>
  <arg name="head_goal_deadband_rad" default="0.04"/>
  <arg name="collision_footprint_radius"              default="$(var robot_radius)"/>
  <arg name="planning_hard_margin"                    default="0.02"/>
  <arg name="dynamic_planning_margin"                 default="-0.1"/>
  <!-- Compatibility alias; negative values never reduce the physical footprint. -->
  <arg name="planning_hard_margin_1"                    default="$(var dynamic_planning_margin)"/>
  <arg name="collision_stop_margin"                   default="0.08"/>

  <!-- ===== Tuning / thresholds ===== -->
  <arg name="cloud_downsampling"                      default="1"/>
  <arg name="cloud_filter_input_qos_mode"             default="dual"/>
  <arg name="cloud_filter_debug"                      default="false"/>
  <arg name="cloud_filter_min_points_per_voxel"       default="2"/>
  <arg name="cloud_filter_min_neighbor_voxels"        default="2"/>
  <arg name="static_obstacle_ignore_radius"           default="0.08"/>
  <arg name="obstacle_cloud_min_neighbor_cells"       default="2"/>
  <arg name="cloud_points_threshold"                  default="15"/>
  <arg name="lidar_points_threshold"                  default="20"/>
  <arg name="mvn_pln_patience"                        default="True"/>

  <!-- ===== Laser detection window ===== -->
  <arg name="laser_min_x"                             default="0.0"/>
  <arg name="laser_max_x"                             default="2.5"/>
  <arg name="laser_min_y"                             default="-1.0"/>
  <arg name="laser_max_y"                             default="1.0"/>
  <arg name="laser_min_z"                             default="0.05"/>
  <arg name="laser_max_z"                             default="1.20"/>

  <!-- ===== Point cloud detection window ===== -->
  <!-- Xtion range is measured in 3D from its optical frame, independent of tilt. -->
  <arg name="cloud_sensor_frame"                      default=""/>
  <arg name="cloud_min_range"                         default="0.60"/>
  <arg name="cloud_max_range"                         default="5.0"/>
  <arg name="self_obstacle_ignore_max_z"              default="0.30"/>
  <arg name="unobserved_obstacle_hold_radius"         default="1.0"/>
  <arg name="unobserved_obstacle_hold_sec"            default="3.0"/>
  <arg name="head_preview_angle_rad"                   default="0.25"/>
  <arg name="head_max_pan_speed"                      default="1.5"/>
  <arg name="head_max_pan_acceleration"               default="2.5"/>
  <arg name="cloud_min_x"                             default="0.0"/>
  <arg name="cloud_max_x"                             default="2.5"/>
  <arg name="cloud_min_y"                             default="-1.0"/>
  <arg name="cloud_max_y"                             default="1.0"/>
  <arg name="cloud_min_z"                             default="0.04"/>
  <arg name="cloud_max_z"                             default="1.20"/>

  <!-- ===== Map Augmenter ===== -->
  <arg name="augmenter_cost_radius"                   default="0.90"/>
  <!--arg name="dynamic_obstacle_inflation_radius"       default="$(eval 'max($(var robot_radius), $(var robot_radius) + $(var planning_hard_margin_1))')"/-->
  <arg name="dynamic_obstacle_inflation_radius"       default= "$(eval '$(var robot_radius) + $(var planning_hard_margin_1)')"/>

  <arg name="augmenter_use_online"                     default="false"/>
  <arg name="use_prohibition_map"                      default="true"/>
  <arg name="require_prohibition_map"                  default="true"/>
  <arg name="circular_inflation"                       default="true"/>
  <!-- The input map contains raw obstacles; inflation includes the base and margin. -->
  <arg name="static_obstacle_inflation_radius"         default="$(eval '$(var robot_radius) + $(var planning_hard_margin)')"/>
  <arg name="augmenter_cost_peak"                      default="15"/>
  <arg name="map_augmenter_debug"                      default="false"/>
  <arg name="augmenter_map_topic_timeout_sec"          default="3.0"/>
  <arg name="augmenter_map_request_timeout_sec"        default="3.0"/>
  <arg name="augmenter_map_refresh_period_sec"         default="1.0"/>
  <arg name="augmenter_publish_period_sec"             default="1.1"/>
  <arg name="augmenter_tf_timeout_sec"                 default="0.03"/>
  <arg name="augmenter_robot_tf_max_age_sec"           default="0.5"/>
  <arg name="augmenter_base_map_topic"                 default="map"/>
  <!--arg name="prohibition_map_topic"                    default=""/-->

  <!-- ===== Obstacle Detector tuning (distances in metres, times in seconds) ===== -->
  <!-- Cloud gating is off by default; when enabled, connect both enable topics. -->
  <arg name="use_point_cloud2"                         default="false"/>
  <arg name="cloud_downsampling2"                      default="1"/>
  <arg name="lidar_downsampling"                       default="1"/>
  <arg name="obstacle_cloud_min_points_per_cell"       default="2"/>
  <arg name="cloud_follow_head"                        default="true"/>
  <arg name="cloud_forward_axis"                       default="z"/>
  <arg name="cloud_yaw_min_horizontal_projection"      default="0.1"/>
  <arg name="cloud_gating_enabled"                     default="false"/>
  <arg name="cloud_navigation_initially_active"        default="false"/>
  <arg name="cloud_override_initially_enabled"         default="true"/>
  <arg name="cloud_navigation_enable_topic"            default="map_augmenter/enable"/>
  <arg name="cloud_enable_topic"                       default="map_augmenter/enable_cloud"/>
  <arg name="remember_all_obstacles"                   default="false"/>
  <arg name="odom_frame"                               default="odom"/>
  <arg name="detector_processing_period_sec"           default="0.075"/>
  <arg name="obstacle_timeout_sec"                     default="1.0"/>
  <arg name="sensor_max_age_sec"                       default="0.5"/>
  <arg name="sensor_future_tolerance_sec"              default="0.05"/>
  <arg name="allow_zero_sensor_stamp"                  default="false"/>
  <arg name="detector_tf_timeout_sec"                  default="0.03"/>
  <arg name="tf_allow_latest_fallback"                 default="true"/>
  <arg name="tf_fallback_max_age_sec"                  default="0.20"/>
  <arg name="ignore_static_obstacles"                  default="true"/>
  <arg name="self_obstacle_ignore_radius"              default="$(var robot_radius)"/>
  <arg name="detector_laser_min_range"                 default="0.10"/>
  <arg name="clear_on_pose_jump"                       default="true"/>
  <arg name="pose_jump_translation_m"                  default="0.5"/>
  <arg name="pose_jump_rotation_rad"                   default="0.35"/>
  <arg name="debug_detection"                          default="false"/>
  <arg name="debug_detection_period_sec"               default="2.0"/>

  <!-- ===== Path Planner ===== -->
  <arg name="diagonal_paths"                          default="True"/>

  <arg name="allow_unknown"                            default="false"/>
  <arg name="unknown_cost"                             default="1.0"/>
  <arg name="smooth_alpha"                             default="0.1"/>
  <arg name="smooth_beta"                              default="0.9"/>
  <arg name="smooth_tolerance"                         default="0.00001"/>
  <!-- Keep occupied cells intact; recovery must not erase footprint clearance. -->
  <arg name="escape_clear_radius"                      default="0.6"/>
  <arg name="goal_relocation_radius"                   default="1.0"/>
  <arg name="disable_rear_path_plan"                   default="false"/>
  <arg name="online_behind_clearance"                  default="1.0"/>
  <arg name="planner_map_refresh_period_sec"           default="0.2"/>
  <arg name="planner_map_snapshot_timeout_sec"         default="1.0"/>
  <arg name="planner_map_request_timeout_sec"          default="5.0"/>
  <arg name="planner_map_pair_retry_limit"             default="1"/>

  <!-- ===== Simple Move ===== -->
  <arg name="max_linear_speed"                        default="0.9"/>
  <arg name="max_angular_speed"                       default="1.30"/>
  <arg name="control_alpha"                           default="0.2"/>
  <arg name="control_beta"                            default="0.6"/>
  <arg name="move_head"                               default="True"/>

  <!-- ===== Coordinated motion (metres, radians, seconds) ===== -->
  <arg name="motion_mode"                             default="omni"/>
  <arg name="linear_acceleration"                     default="0.3"/>
  <arg name="angular_acceleration"                    default="0.8"/>
  <arg name="linear_jerk"                             default="1.5"/>
  <arg name="angular_jerk"                            default="4.0"/>
  <arg name="fine_dist_tolerance"                     default="0.08"/>
  <arg name="angle_tolerance"                         default="0.08"/>
  <arg name="lookahead_min_m"                         default="0.20"/>
  <arg name="lookahead_max_m"                         default="0.60"/>
  <arg name="lookahead_time_sec"                      default="0.6"/>
  <arg name="direction_filter_time_sec"               default="0.15"/>
  <arg name="direction_max_rate_rad_sec"              default="1.2"/>
  <arg name="initial_alignment_fraction"              default="0.10"/>
  <arg name="final_alignment_fraction"                default="0.10"/>
  <!-- Match the installed head controller limits; runtime move_head defaults to true. -->
  <arg name="head_pan_min"                            default="-3.14"/>
  <arg name="head_pan_max"                            default="1.74"/>
  <arg name="head_tilt"                               default="-0.5"/>
  <arg name="head_alignment_tolerance"                default="0.20"/>
  <arg name="head_pan_limit_margin"                   default="0.05"/>
  <arg name="head_stop_error_rad"                     default="0.55"/>
  <arg name="head_lookahead_time_sec"                 default="0.25"/>
  <arg name="final_position_hysteresis_m"              default="0.03"/>
  <arg name="final_capture_distance_m"                 default="0.40"/>
  <arg name="final_angle_max_angular_speed"             default="0.50"/>
  <arg name="angular_damping"                           default="0.50"/>
  <arg name="head_feedback_timeout_sec"               default="0.5"/>
  <arg name="head_alignment_timeout_sec"              default="10.0"/>
  <arg name="max_path_deviation_m"                    default="0.35"/>
  <arg name="deviation_persistence_sec"               default="0.5"/>
  <arg name="progress_timeout_sec"                    default="8.0"/>
  <arg name="sensor_wait_timeout_sec"                  default="10.0"/>
  <arg name="start_escape_speed"                       default="0.08"/>
  <arg name="navigation_sensor_timeout_sec"           default="0.5"/>
  <arg name="navigation_tf_timeout_sec"               default="0.5"/>

  <!-- ===== Navigation coordination ===== -->
  <arg name="plan_request_timeout_sec"                default="5.0"/>
  <arg name="replan_period_sec"                       default="1.0"/>
  <arg name="navigation_map_timeout_sec"              default="3.0"/>
  <arg name="controller_timeout_sec"                  default="2.0"/>
  <arg name="path_check_horizon_m"                    default="2.0"/>
  <arg name="local_avoidance_timeout_sec"              default="3.0"/>
  <arg name="local_blocked_hold_sec"                  default="1.5"/>
  <arg name="local_avoidance_speed"                   default="0.20"/>
  <arg name="avoidance_switch_hold_sec"                default="0.25"/>
  <arg name="avoidance_switch_score_margin"            default="0.03"/>
  <arg name="max_avoidance_deviation_m"                default="0.55"/>
  <arg name="max_recovery_attempts"                   default="3"/>
  <arg name="planning_recovery_timeout_sec"           default="30.0"/>
  <arg name="recovery_progress_m"                     default="0.4"/>
  <arg name="recovery_path_horizon_m"                 default="0.8"/>
  <arg name="recovery_path_difference_m"              default="0.12"/>
  <arg name="recovery_cost_radius"                    default="0.35"/>
  <arg name="recovery_cost_peak"                      default="40.0"/>

  <!-- ===== Strict path quality ===== -->
  <arg name="require_smooth_path"                     default="true"/>
  <arg name="smoothing_retry_limit"                   default="8"/>
  <arg name="smoothing_time_budget_sec"               default="1.0"/>
  <arg name="max_path_curvature"                      default="6.0"/>
  <arg name="max_path_heading_step"                   default="0.50"/>

  <!-- ===== Potential Fields ===== -->
  <arg name="collision_reaction_time_sec"              default="0.10"/>
  <arg name="collision_critical_margin"                default="0.02"/>
  <arg name="repulsion_max_speed"                     default="0.15"/>
  <arg name="repulsion_filter_time_sec"               default="0.15"/>
  <arg name="pot_fields_debug"                        default="False"/>
  <arg name="show_image"                              default="False"/>
  <arg name="laser_pot_fields_d0"                     default="0.75"/>
  <arg name="laser_pot_fields_k_rej"                  default="0.40"/>
  <arg name="cloud_pot_fields_d0"                     default="0.80"/>
  <arg name="cloud_pot_fields_k_rej"                  default="0.20"/>
  <arg name="cloud_collision_min_y"                   default="-0.30"/>
  <arg name="cloud_collision_max_y"                   default="0.30"/>
  <arg name="laser_collision_min_y"                   default="-0.25"/>
  <arg name="laser_collision_max_y"                   default="0.25"/>


  <!-- ================================================================== -->
  <!--                         Map Servers                                -->
  <!-- ================================================================== -->

  <node name="static_map_server"
        pkg="nav2_map_server"
        exec="map_server"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="yaml_filename" value="$(var static_map_file)"/>
  </node>

  <node name="prohibition_map_server"
        pkg="nav2_map_server"
        exec="map_server"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)"
        ros_args="--log-level warn">
    <param name="yaml_filename" value="$(var prohibition_map_file)"/>
    <remap from="map" to="fixed_prohibition_layer_map"/>
  </node>


  <!-- ================================================================== -->
  <!--                      Localization (AMCL)                           -->
  <!-- ================================================================== -->

  <include file="$(find-pkg-share navigation_start)/launch/amcl_hsr.launch.xml"/>

  <node name="lifecycle_manager_map"
        pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_sim_time"      value="$(var use_sim_time)"/>
    <param name="autostart"         value="true"/>
    <param name="node_names"        value="['static_map_server', 'prohibition_map_server', 'amcl']"/>
  </node>


  <!-- ================================================================== -->
  <!--                        Map Augmentation                            -->
  <!-- ================================================================== -->
  <node name="map_augmenter"
        pkg="map_augmenter"
        exec="map_augmenter_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="debug_detection" value="$(var debug_detection)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="use_online"                               value="$(var augmenter_use_online)"/>
    <param name="use_prohibition_map"                      value="$(var use_prohibition_map)"/>
    <param name="require_prohibition_map"                  value="$(var require_prohibition_map)"/>
    <param name="circular_inflation"                       value="$(var circular_inflation)"/>
    <param name="robot_radius"                            value="$(var robot_radius)"/>
    <param name="static_obstacle_inflation_radius"         value="$(var static_obstacle_inflation_radius)"/>
    <param name="cost_peak"                                value="$(var augmenter_cost_peak)"/>
    <param name="debug_maps"                               value="$(var map_augmenter_debug)"/>
    <param name="map_topic_timeout_sec"                    value="$(var augmenter_map_topic_timeout_sec)"/>
    <param name="map_request_timeout_sec"                  value="$(var augmenter_map_request_timeout_sec)"/>
    <param name="map_refresh_period_sec"                   value="$(var augmenter_map_refresh_period_sec)"/>
    <param name="publish_period_sec"                       value="$(var augmenter_publish_period_sec)"/>
    <param name="tf_timeout_sec"                           value="$(var augmenter_tf_timeout_sec)"/>
    <param name="robot_tf_max_age_sec"                     value="$(var augmenter_robot_tf_max_age_sec)"/>
    <param name="base_map_topic"                           value="$(var augmenter_base_map_topic)"/>
    <!--param name="prohibition_map_topic"                    value="$(var prohibition_map_topic)" type="str"/-->
    <param name="use_namespace"                             value="$(var use_namespace)"/>
    <param name="static_map_server"                         value="static_map_server/map"/>
    <param name="prohibition_map_server"                    value="prohibition_map_server/map"/>
    <param name="base_link_name"                            value="$(var base_link_name)"/>
    <param name="cost_radius"                               value="$(var augmenter_cost_radius)"/>
    <param name="dynamic_obstacle_inflation_radius"         value="$(var dynamic_obstacle_inflation_radius)"/>

    <remap from="point_obstacle"         to="clicked_point"/>
  </node>

  <node name="obstacle_detector"
        pkg="map_augmenter"
        exec="obstacle_detector_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="use_point_cloud2"                         value="$(var use_point_cloud2)"/>
    <param name="point_cloud_topic2"                       value="$(var point_cloud_topic2)"/>
    <param name="cloud_downsampling"                       value="$(var cloud_downsampling)"/>
    <param name="cloud_downsampling2"                      value="$(var cloud_downsampling2)"/>
    <param name="lidar_downsampling"                       value="$(var lidar_downsampling)"/>
    <param name="cloud_min_points_per_cell"                value="$(var obstacle_cloud_min_points_per_cell)"/>
    <param name="cloud_follow_head"                        value="$(var cloud_follow_head)"/>
    <param name="cloud_forward_axis"                       value="$(var cloud_forward_axis)" type="str"/>
    <param name="cloud_yaw_min_horizontal_projection"      value="$(var cloud_yaw_min_horizontal_projection)"/>
    <param name="cloud_gating_enabled"                     value="$(var cloud_gating_enabled)"/>
    <param name="cloud_navigation_initially_active"        value="$(var cloud_navigation_initially_active)"/>
    <param name="cloud_override_initially_enabled"         value="$(var cloud_override_initially_enabled)"/>
    <param name="cloud_navigation_enable_topic"            value="$(var cloud_navigation_enable_topic)"/>
    <param name="cloud_enable_topic"                       value="$(var cloud_enable_topic)"/>
    <param name="remember_all_obstacles"                   value="$(var remember_all_obstacles)"/>
    <param name="odom_frame"                               value="$(var odom_frame)"/>
    <param name="processing_period_sec"                    value="$(var detector_processing_period_sec)"/>
    <param name="unobserved_obstacle_hold_radius"          value="$(var unobserved_obstacle_hold_radius)"/>
    <param name="unobserved_obstacle_hold_sec"             value="$(var unobserved_obstacle_hold_sec)"/>
    <param name="obstacle_timeout_sec"                     value="$(var obstacle_timeout_sec)"/>
    <param name="sensor_max_age_sec"                       value="$(var sensor_max_age_sec)"/>
    <param name="sensor_future_tolerance_sec"              value="$(var sensor_future_tolerance_sec)"/>
    <param name="allow_zero_sensor_stamp"                  value="$(var allow_zero_sensor_stamp)"/>
    <param name="tf_timeout_sec"                           value="$(var detector_tf_timeout_sec)"/>
    <param name="tf_allow_latest_fallback"                 value="$(var tf_allow_latest_fallback)"/>
    <param name="tf_fallback_max_age_sec"                  value="$(var tf_fallback_max_age_sec)"/>
    <param name="ignore_static_obstacles"                  value="$(var ignore_static_obstacles)"/>
    <param name="self_obstacle_ignore_radius"              value="$(var self_obstacle_ignore_radius)"/>
    <param name="laser_min_range"                          value="$(var detector_laser_min_range)"/>
    <param name="clear_on_pose_jump"                       value="$(var clear_on_pose_jump)"/>
    <param name="pose_jump_translation_m"                  value="$(var pose_jump_translation_m)"/>
    <param name="pose_jump_rotation_rad"                   value="$(var pose_jump_rotation_rad)"/>
    <param name="debug_detection"                          value="$(var debug_detection)"/>
    <param name="debug_detection_period_sec"               value="$(var debug_detection_period_sec)"/>
    <param name="use_namespace"                       value="$(var use_namespace)"/>
    <param name="laser_scan_topic"                    value="$(var laser_scan_topic)"/>
    <param name="point_cloud_topic"                   value="$(var point_cloud_topic)"/>
    <param name="base_link_name"                      value="$(var base_link_name)"/>
    <param name="use_lidar"                           value="$(var use_lidar)"/>
    <param name="use_point_cloud"                     value="$(var use_point_cloud)"/>
    <param name="static_obstacle_ignore_radius"       value="$(var static_obstacle_ignore_radius)"/>
    <param name="cloud_min_neighbor_cells"            value="$(var obstacle_cloud_min_neighbor_cells)"/>
    <param name="laser_min_x"                         value="$(var laser_min_x)"/>
    <param name="laser_max_x"                         value="$(var laser_max_x)"/>
    <param name="laser_min_y"                         value="$(var laser_min_y)"/>
    <param name="laser_max_y"                         value="$(var laser_max_y)"/>
    <param name="laser_min_z"                         value="$(var laser_min_z)"/>
    <param name="laser_max_z"                         value="$(var laser_max_z)"/>
    <param name="cloud_sensor_frame"                       value="$(var cloud_sensor_frame)" type="str"/>
    <param name="cloud_min_range"                          value="$(var cloud_min_range)"/>
    <param name="cloud_max_range"                          value="$(var cloud_max_range)"/>
    <param name="self_obstacle_ignore_max_z"               value="$(var self_obstacle_ignore_max_z)"/>
    <param name="cloud_min_x"                         value="$(var cloud_min_x)"/>
    <param name="cloud_max_x"                         value="$(var cloud_max_x)"/>
    <param name="cloud_min_y"                         value="$(var cloud_min_y)"/>
    <param name="cloud_max_y"                         value="$(var cloud_max_y)"/>
    <param name="cloud_min_z"                         value="$(var cloud_min_z)"/>
    <param name="cloud_max_z"                         value="$(var cloud_max_z)"/>
  </node>


  <!-- ================================================================== -->
  <!--                         Path Planning                              -->
  <!-- ================================================================== -->
  <node name="path_planner"
        pkg="path_planner"
        exec="path_planner_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_sim_time"                             value="$(var use_sim_time)"/>
    <param name="allow_unknown"                            value="$(var allow_unknown)"/>
    <param name="unknown_cost"                             value="$(var unknown_cost)"/>
    <param name="smooth_alpha"                             value="$(var smooth_alpha)"/>
    <param name="smooth_beta"                              value="$(var smooth_beta)"/>
    <param name="smooth_tolerance"                         value="$(var smooth_tolerance)"/>
    <param name="require_smooth_path"                      value="$(var require_smooth_path)"/>
    <param name="smoothing_retry_limit"                    value="$(var smoothing_retry_limit)"/>
    <param name="smoothing_time_budget_sec"                value="$(var smoothing_time_budget_sec)"/>
    <param name="max_path_curvature"                       value="$(var max_path_curvature)"/>
    <param name="max_path_heading_step"                    value="$(var max_path_heading_step)"/>
    <param name="escape_clear_radius"                      value="$(var escape_clear_radius)"/>
    <param name="goal_relocation_radius"                   value="$(var goal_relocation_radius)"/>
    <param name="disable_rear_path_plan"                   value="$(var disable_rear_path_plan)"/>
    <param name="online_behind_clearance"                  value="$(var online_behind_clearance)"/>
    <param name="map_refresh_period_sec"                   value="$(var planner_map_refresh_period_sec)"/>
    <param name="map_snapshot_timeout_sec"                 value="$(var planner_map_snapshot_timeout_sec)"/>
    <param name="recovery_cost_radius"                      value="$(var recovery_cost_radius)"/>
    <param name="recovery_cost_peak"                        value="$(var recovery_cost_peak)"/>
    <param name="map_request_timeout_sec"                  value="$(var planner_map_request_timeout_sec)"/>
    <param name="map_pair_retry_limit"                     value="$(var planner_map_pair_retry_limit)"/>
    <param name="use_namespace"                            value="$(var use_namespace)"/>
    <param name="diagonal_paths"                           value="$(var diagonal_paths)"/>
    <param name="robot_radius" value="$(var robot_radius)"/>
    <param name="start_recovery_margin" value="$(var start_recovery_margin)"/>
    <param name="start_recovery_search_radius" value="$(var start_recovery_search_radius)"/>
  </node>

  <!-- ================================================================== -->
  <!--                         Simple Move                                -->
  <!-- ================================================================== -->
  <node name="simple_move"
        pkg="simple_move"
        exec="simple_move_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="robot_radius" value="$(var robot_radius)"/>
    <param name="debug_detection" value="$(var debug_detection)"/>
    <param name="use_namespace"                 value="$(var use_namespace)"/>
    <param name="max_linear_speed"              value="$(var max_linear_speed)"/>
    <param name="max_angular_speed"             value="$(var max_angular_speed)"/>
    <param name="control_alpha"                 value="$(var control_alpha)"/>
    <param name="control_beta"                  value="$(var control_beta)"/>
    <param name="move_head"                     value="$(var move_head)"/>
    <param name="use_pot_fields"                value="$(var use_pot_fields)"/>
    <param name="base_link_name"                value="$(var base_link_name)"/>
    <remap from="/cmd_vel"                      to="$(var cmd_vel_topic)"/>
    <param name="motion_mode"                   value="$(var motion_mode)"/>
    <param name="linear_acceleration"           value="$(var linear_acceleration)"/>
    <param name="angular_acceleration"          value="$(var angular_acceleration)"/>
    <param name="linear_jerk"                   value="$(var linear_jerk)"/>
    <param name="angular_jerk"                  value="$(var angular_jerk)"/>
    <param name="fine_dist_tolerance"           value="$(var fine_dist_tolerance)"/>
    <param name="angle_tolerance"               value="$(var angle_tolerance)"/>
    <param name="lookahead_min_m"               value="$(var lookahead_min_m)"/>
    <param name="lookahead_max_m"               value="$(var lookahead_max_m)"/>
    <param name="lookahead_time_sec"            value="$(var lookahead_time_sec)"/>
    <param name="direction_filter_time_sec"     value="$(var direction_filter_time_sec)"/>
    <param name="direction_max_rate_rad_sec"    value="$(var direction_max_rate_rad_sec)"/>
    <param name="initial_alignment_fraction"    value="$(var initial_alignment_fraction)"/>
    <param name="final_alignment_fraction"      value="$(var final_alignment_fraction)"/>
    <param name="start_escape_radius"          value="$(var escape_clear_radius)"/>
    <param name="start_escape_speed"           value="$(var start_escape_speed)"/>
    <param name="head_preview_angle_rad"       value="$(var head_preview_angle_rad)"/>
    <param name="head_max_pan_speed"            value="$(var head_max_pan_speed)"/>
    <param name="head_max_pan_acceleration"     value="$(var head_max_pan_acceleration)"/>
    <param name="odom_name"                     value="$(var odom_frame)"/>
    <param name="head_pan_min"                  value="$(var head_pan_min)"/>
    <param name="head_pan_max"                  value="$(var head_pan_max)"/>
    <param name="head_tilt"                     value="$(var head_tilt)"/>
    <param name="head_alignment_tolerance"      value="$(var head_alignment_tolerance)"/>
    <param name="head_pan_limit_margin"         value="$(var head_pan_limit_margin)"/>
    <param name="head_stop_error_rad"           value="$(var head_stop_error_rad)"/>
    <param name="head_lookahead_time_sec"        value="$(var head_lookahead_time_sec)"/>
    <param name="final_position_hysteresis_m"    value="$(var final_position_hysteresis_m)"/>
    <param name="final_capture_distance_m"       value="$(var final_capture_distance_m)"/>
    <param name="final_angle_max_angular_speed"   value="$(var final_angle_max_angular_speed)"/>
    <param name="angular_damping"                value="$(var angular_damping)"/>
    <param name="local_avoidance_timeout_sec"     value="$(var local_blocked_hold_sec)"/>
    <param name="local_avoidance_speed"           value="$(var local_avoidance_speed)"/>
    <param name="avoidance_switch_hold_sec"        value="$(var avoidance_switch_hold_sec)"/>
    <param name="avoidance_switch_score_margin"    value="$(var avoidance_switch_score_margin)"/>
    <param name="max_avoidance_deviation_m"       value="$(var max_avoidance_deviation_m)"/>
    <param name="head_feedback_timeout_sec"     value="$(var head_feedback_timeout_sec)"/>
    <param name="head_alignment_timeout_sec"    value="$(var head_alignment_timeout_sec)"/>
    <param name="max_path_deviation_m"          value="$(var max_path_deviation_m)"/>
    <param name="deviation_persistence_sec"     value="$(var deviation_persistence_sec)"/>
    <param name="progress_timeout_sec"          value="$(var progress_timeout_sec)"/>
    <param name="repulsion_max_speed"           value="$(var repulsion_max_speed)"/>
    <param name="sensor_timeout_sec"            value="$(var navigation_sensor_timeout_sec)"/>
    <param name="tf_timeout_sec"                value="$(var navigation_tf_timeout_sec)"/>
    <param name="map_timeout_sec"               value="$(var navigation_map_timeout_sec)"/>
    <remap from="/hardware/head/goal_pose"             to="/$(var namespace_hardware)/head/goal_pose"/>
    <remap from="/hardware/head/current_pose"          to="/$(var namespace_hardware)/head/current_pose"/>
    <param name="use_sim_time"                  value="$(var use_sim_time)"/>
    <param name="collision_reaction_time_sec"   value="$(var collision_reaction_time_sec)"/>
    <param name="final_position_settle_sec" value="$(var final_position_settle_sec)"/>
    <param name="head_goal_deadband_rad" value="$(var head_goal_deadband_rad)"/>
  </node>

  <!-- ================================================================== -->
  <!--                         Potential Fields                           -->
  <!-- ================================================================== -->
  <node name="potential_fields"
        pkg="potential_fields"
        exec="potential_fields_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"                 value="$(var use_namespace)"/>
    <param name="debug"                         value="$(var pot_fields_debug)"/>
    <param name="show_image"                    value="$(var show_image)"/>
    <param name="use_pot_fields"                value="$(var use_pot_fields)"/>
    <param name="use_lidar"                     value="$(var use_lidar)"/>
    <param name="use_point_cloud"               value="$(var use_point_cloud)"/>
    <param name="laser_min_x"                   value="$(var laser_min_x)"/>
    <param name="laser_max_x"                   value="$(var laser_max_x)"/>
    <param name="laser_min_y"                   value="$(var laser_min_y)"/>
    <param name="laser_max_y"                   value="$(var laser_max_y)"/>
    <param name="laser_min_z"                   value="$(var laser_min_z)"/>
    <param name="laser_max_z"                   value="$(var laser_max_z)"/>
    <param name="cloud_sensor_frame"            value="$(var cloud_sensor_frame)" type="str"/>
    <param name="cloud_min_points_per_cell"     value="$(var obstacle_cloud_min_points_per_cell)"/>
    <param name="cloud_min_range"               value="$(var cloud_min_range)"/>
    <param name="cloud_max_range"               value="$(var cloud_max_range)"/>
    <param name="self_obstacle_ignore_max_z"    value="$(var self_obstacle_ignore_max_z)"/>
    <param name="cloud_min_x"                   value="$(var cloud_min_x)"/>
    <param name="cloud_max_x"                   value="$(var cloud_max_x)"/>
    <param name="cloud_min_y"                   value="$(var cloud_min_y)"/>
    <param name="cloud_max_y"                   value="$(var cloud_max_y)"/>
    <param name="cloud_min_z"                   value="$(var cloud_min_z)"/>
    <param name="cloud_max_z"                   value="$(var cloud_max_z)"/>
    <param name="laser_pot_fields_d0"           value="$(var laser_pot_fields_d0)"/>
    <param name="laser_pot_fields_k_rej"        value="$(var laser_pot_fields_k_rej)"/>
    <param name="cloud_pot_fields_d0"           value="$(var cloud_pot_fields_d0)"/>
    <param name="cloud_pot_fields_k_rej"        value="$(var cloud_pot_fields_k_rej)"/>
    <param name="cloud_downsampling"            value="$(var cloud_downsampling)"/>
    <param name="cloud_points_threshold"        value="$(var cloud_points_threshold)"/>
    <param name="lidar_points_threshold"        value="$(var lidar_points_threshold)"/>
    <param name="laser_collision_min_y"         value="$(var laser_collision_min_y)"/>
    <param name="laser_collision_max_y"         value="$(var laser_collision_max_y)"/>
    <param name="cloud_collision_min_y"         value="$(var cloud_collision_min_y)"/>
    <param name="cloud_collision_max_y"         value="$(var cloud_collision_max_y)"/>
    <param name="point_cloud_topic"             value="$(var point_cloud_topic)"/>
    <param name="laser_scan_topic"              value="$(var laser_scan_topic)"/>
    <remap from="/cmd_vel"                      to="$(var cmd_vel_topic)"/>
    <param name="base_link_name"                value="$(var base_link_name)"/>
    <param name="self_obstacle_ignore_radius"   value="$(var self_obstacle_ignore_radius)"/>
    <param name="collision_footprint_radius"    value="$(var collision_footprint_radius)"/>
    <param name="collision_stop_margin"         value="$(var collision_stop_margin)"/>
    <param name="repulsion_max_speed"           value="$(var repulsion_max_speed)"/>
    <param name="repulsion_filter_time_sec"     value="$(var repulsion_filter_time_sec)"/>
    <param name="collision_deceleration"        value="$(var linear_acceleration)"/>
    <param name="no_sensor_data_timeout"        value="$(var navigation_sensor_timeout_sec)"/>
    <param name="use_sim_time"                  value="$(var use_sim_time)"/>
    <param name="sensor_future_tolerance_sec"   value="$(var sensor_future_tolerance_sec)"/>
    <param name="tf_timeout_sec"                value="$(var detector_tf_timeout_sec)"/>
    <param name="tf_allow_latest_fallback"      value="$(var tf_allow_latest_fallback)"/>
    <param name="tf_fallback_max_age_sec"       value="$(var tf_fallback_max_age_sec)"/>
    <param name="collision_reaction_time_sec"   value="$(var collision_reaction_time_sec)"/>
    <param name="collision_critical_margin"     value="$(var collision_critical_margin)"/>
  </node>

  <node name="publish_enable"
        pkg="potential_fields"
        exec="publish_enable.py"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace" value="$(var use_namespace)"/>
  </node>


  <!-- ================================================================== -->
  <!--                         Motion Planner                             -->
  <!-- ================================================================== -->

  <node name="mvn_pln"
        pkg="mvn_pln"
        exec="mvn_pln_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="odom_name" value="$(var odom_frame)"/>
    <param name="debug_detection" value="$(var debug_detection)"/>
    <param name="use_namespace"            value="$(var use_namespace)"/>
    <param name="sensor_wait_timeout_sec"   value="$(var sensor_wait_timeout_sec)"/>
    <param name="start_escape_radius"       value="$(var escape_clear_radius)"/>
    <param name="patience"                 value="$(var mvn_pln_patience)"/>
    <param name="base_link_name"           value="$(var base_link_name)"/>
    <remap from="nav_control/goal" to="move_base_simple/goal"/>
    <param name="plan_request_timeout_sec" value="$(var plan_request_timeout_sec)"/>
    <param name="replan_period_sec"        value="$(var replan_period_sec)"/>
    <param name="controller_timeout_sec"   value="$(var controller_timeout_sec)"/>
    <param name="path_check_horizon_m"     value="$(var path_check_horizon_m)"/>
    <param name="max_recovery_attempts"    value="$(var max_recovery_attempts)"/>
    <param name="planning_recovery_timeout_sec" value="$(var planning_recovery_timeout_sec)"/>
    <param name="local_avoidance_timeout_sec" value="$(var local_avoidance_timeout_sec)"/>
    <param name="recovery_progress_m"      value="$(var recovery_progress_m)"/>
    <param name="recovery_path_horizon_m"  value="$(var recovery_path_horizon_m)"/>
    <param name="recovery_path_difference_m" value="$(var recovery_path_difference_m)"/>
    <param name="goal_position_tolerance_m" value="$(var fine_dist_tolerance)"/>
    <param name="goal_angle_tolerance_rad" value="$(var angle_tolerance)"/>
    <param name="tf_timeout_sec"           value="$(var navigation_tf_timeout_sec)"/>
    <param name="map_timeout_sec"          value="$(var navigation_map_timeout_sec)"/>
    <param name="use_sim_time"             value="$(var use_sim_time)"/>
    <param name="robot_radius" value="$(var robot_radius)"/>
    <param name="near_goal_extra_margin" value="$(var near_goal_extra_margin)"/>
    <param name="near_goal_min_progress" value="$(var near_goal_min_progress)"/>
  </node>


  <!-- ================================================================== -->
  <!--           Navigation Interface Nodes  (no namespace)               -->
  <!-- ================================================================== -->

  <node pkg="locations_manager"
        exec="locations_manager_node"
        name="locations_manager_node"
        output="screen"/>

  <node pkg="nav_controller"
        exec="nav_controller_node"
        name="nav_controller_node"
        output="screen"/>

</launch>
