<launch>

  <!-- ============================= -->
  <!--           AMCL NODE          -->
  <!-- ============================= -->

  <node pkg="nav2_amcl"
        exec="amcl"
        name="amcl"
        namespace="navigation"
        output="screen">

    <!-- Frames -->
    <param name="base_frame_id" value="base_footprint"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="global_frame_id" value="map"/>

    <!-- Topics -->
    <param name="scan_topic" value="/hardware/base/scan"/>
    <param name="odom_topic" value="/hardware/base/odom"/>

    <!-- ============================= -->
    <!--      PARTICLE FILTER         -->
    <!-- ============================= -->

    <param name="min_particles" value="500"/>
    <param name="max_particles" value="1500"/>
    <param name="kld_err" value="0.02"/>
    <param name="kld_z" value="0.99"/>
    <param name="resample_interval" value="1"/>

    <!-- ============================= -->
    <!--    OMNI MOTION MODEL         -->
    <!-- ============================= -->

    <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/>

    <param name="alpha1" value="0.15"/>
    <param name="alpha2" value="0.15"/>
    <param name="alpha3" value="0.20"/>
    <param name="alpha4" value="0.20"/>
    <param name="alpha5" value="0.10"/>

    <!-- ============================= -->
    <!--       LASER MODEL            -->
    <!-- ============================= -->

    <param name="laser_model_type" value="likelihood_field"/>

    <!-- Reducimos beams para estabilidad -->
    <param name="laser_max_beams" value="60"/>
    <param name="laser_max_range" value="18.0"/>
    <param name="laser_min_range" value="0.1"/>

    <param name="laser_z_hit" value="0.9"/>
    <param name="laser_z_rand" value="0.1"/>
    <param name="laser_sigma_hit" value="0.15"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <!-- ============================= -->
    <!--       UPDATE CONTROL         -->
    <!-- ============================= -->

    <param name="update_min_d" value="0.05"/>
    <param name="update_min_a" value="0.10"/>

    <!-- ============================= -->
    <!--           TF                 -->
    <!-- ============================= -->

    <param name="tf_broadcast" value="false"/>
    <!--<param name="transform_tolerance" value="0.3"/>-->

    <!-- ============================= -->
    <!--         RECOVERY             -->
    <!-- ============================= -->

    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.1"/>

    <!-- Misc -->
    <param name="use_sim_time" value="false"/>

     <!-- Initial Pose -->
    <param name="set_initial_pose" value="true"/>
    <param name="initial_pose.x" value="0.0"/>
    <param name="initial_pose.y" value="0.0"/>
    <param name="initial_pose.z" value="0.0"/>
    <param name="initial_pose.yaw" value="0.0"/>

  </node>

</launch>