<launch>

  <!-- ===== Global args ===== -->
  <arg name="use_sim_time" default="false"/>
  <arg name="namespace_hardware" default="hardware"/>
  <arg name="namespace_nav" default="navigation"/>
  <arg name="use_namespace" default="true"/>

  <!-- ===== Map server args ===== -->
  <arg name="static_map_file" default="$(find-pkg-share navigation_start)/maps/maps/lab2025/map.yaml"/>
  <arg name="prohibition_map_file" default="$(find-pkg-share navigation_start)/maps/maps/lab2025/map.yaml"/>

  <!-- ===== Topic args (I/O) ===== -->
  <arg name="pose_topic" default="pose"/>
  <arg name="point_cloud_topic" default="/$(var namespace_hardware)/camera/points"/>
  <!--arg name="bumper_f_topic" default="/bumper"/-->

  <arg name="laser_scan_topic"  default="/$(var namespace_hardware)/base/scan"/>
  <arg name="odom_topic"        default="/$(var namespace_hardware)/base/odom"/>
  <arg name="cmd_vel_topic"     default="/$(var namespace_hardware)/base/cmd_vel"/>
  <arg name="bumper_f_topic"    default="/$(var namespace_hardware)/base/bumper"/>

  <!-- ===== Feature toggles ===== -->
  <arg name="use_lidar" default="True"/>
  <arg name="use_sonars" default="False"/>
  <arg name="use_point_cloud" default="True"/>
  <arg name="use_bumper" default="False"/>
  <arg name="use_pot_fields" default="False"/>

  <!-- ===== Thresholds / tuning ===== -->
  <arg name="cloud_downsampling" default="5"/>
  <arg name="lidar_downsampling" default="1"/>
  <arg name="cloud_points_threshold" default="100"/>
  <arg name="lidar_points_threshold" default="20"/>
  <arg name="mvn_pln_patience" default="True"/>

  <!-- ===== Sensing windows (laser) ===== -->
  <arg name="laser_min_x" default="0.17"/>
  <arg name="laser_max_x" default="0.55"/>
  <arg name="laser_min_y" default="-0.35"/>
  <arg name="laser_max_y" default="0.35"/>
  <arg name="laser_min_z" default="0.025"/>
  <arg name="laser_max_z" default="1.00"/>

  <!-- ===== Sensing windows (cloud) ===== -->
  <arg name="cloud_min_x" default="0.30"/>
  <arg name="cloud_max_x" default="0.80"/>
  <arg name="cloud_min_y" default="-0.30"/>
  <arg name="cloud_max_y" default="0.30"/>
  <arg name="cloud_min_z" default="0.01"/>
  <arg name="cloud_max_z" default="1.0"/>

  <!-- ===== Map servers ===== -->
  <node name="static_map_server"
        pkg="nav2_map_server"
        exec="map_server"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="yaml_filename" value="$(var static_map_file)"/>
  </node>

  <node name="prohibition_map_server"
        pkg="nav2_map_server"
        exec="map_server"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="yaml_filename" value="$(var prohibition_map_file)"/>
    <!-- remap /map -> fixed_prohibition_layer_map inside namespace -->
    <remap from="map" to="fixed_prohibition_layer_map"/>
  </node>

  <!-- ===== Localization (nav2-amcl) ===== -->
  <node name="amcl"
        pkg="nav2_amcl"
        exec="amcl"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">

    <!-- === PARTICLES / TIEMPOS === -->
    <param name="min_particles"        value="500"/>
    <param name="max_particles"        value="3000"/>
    <param name="pf_err"              value="0.05"/>
    <param name="pf_z"                value="0.99"/>
    <param name="update_min_d"        value="0.05"/>   <!-- 5 cm -->
    <param name="update_min_a"        value="0.1"/>    <!-- ~5.7° -->
    <param name="resample_interval"   value="1"/>
    <param name="transform_tolerance" value="0.2"/>
    <param name="save_pose_rate"      value="0.5"/>

    <!-- === FRAMES (no namespaced) === -->
    <param name="global_frame_id" value="map"/>
    <param name="odom_frame_id"   value="odom"/>
    <param name="base_frame_id"   value="base_link"/>
    <param name="tf_broadcast"    value="true"/>

    <!-- === MODELO DE LÁSER (URG-04LX-UG01) === -->
    <param name="laser_min_range"           value="0.06"/>
    <param name="laser_max_range"           value="3.8"/>
    <param name="max_beams"                 value="60"/>
    <param name="laser_model_type"          value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <param name="z_hit"       value="0.8"/>
    <param name="z_short"     value="0.1"/>
    <param name="z_max"       value="0.05"/>
    <param name="z_rand"      value="0.05"/>
    <param name="sigma_hit"   value="0.2"/>
    <param name="lambda_short" value="0.1"/>

    <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/>

    <param name="alpha1" value="0.08"/>  
    <param name="alpha2" value="0.06"/>  
    <param name="alpha3" value="0.05"/>  
    <param name="alpha4" value="0.05"/>  
    <param name="alpha5" value="0.18"/>

    <!-- === INITIAL POSE === -->
    <param name="set_initial_pose" value="true"/>
    <param name="initial_pose.x"   value="0.0"/>
    <param name="initial_pose.y"   value="0.0"/>
    <param name="initial_pose.z"   value="0.0"/>
    <param name="initial_pose.yaw" value="0.0"/>

    <!-- === TOPICS === -->
    <remap from="scan" to="/hardware/base/scan"/>
    <remap from="odom" to="/hardware/base/odom"/>

    <!-- standard publications -->
    <remap from="amcl_pose"     to="$(var pose_topic)"/>
    <remap from="particle_cloud" to="particle_cloud"/>
  </node>

  <!-- ===== Lifecycle Manager ===== -->
  <node name="lifecycle_manager_map"
        pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart" value="true"/>
    <param name="node_names" value="['static_map_server', 'prohibition_map_server', 'amcl']"/>
  </node>

  <!-- ===== Map Enhancer (online) ===== -->
  <node name="map_enhancer"
        pkg="augment_gridmap_online"
        exec="augment_gridmap_online_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <remap from="point_obstacle" to="clicked_point"/>
    <param name="use_namespace" value="$(var use_namespace)"/>
    <param name="obstacle_radius" value="0.05"/>
    <param name="debug" value="True"/>

    <param name="input_map" value="fixed_prohibition_layer_map"/>
    <remap from="grid_map/get_augmented_map" to="prohibition_map"/>
    <remap from="grid_map/augmented_map" to="prohibition_layer_map"/>
  </node>

  <!-- ===== Map Augmenter (offline/services) ===== -->
  <!--<node name="map_augmenter"
        pkg="map_augmenter"
        exec="map_augmenter_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace" value="$(var use_namespace)"/>
    <param name="laser_scan_topic" value="$(var laser_scan_topic)"/>
    <param name="point_cloud_topic" value="$(var point_cloud_topic)"/>
    <param name="static_map_server" value="static_map_server/map"/>
    <param name="prohibition_map_server" value="prohibition_map"/>
    <param name="base_link_name" value="base_link"/>

    <remap from="point_obstacle" to="clicked_point"/>

    <param name="use_lidar" value="$(var use_lidar)"/>
    <param name="use_sonars" value="$(var use_sonars)"/>
    <param name="use_point_cloud" value="$(var use_point_cloud)"/>

    <param name="cloud_downsampling" value="$(var cloud_downsampling)"/>

    <param name="decay_factor" value="20"/>
    <param name="inflation_radius" value="0.22"/>
    <param name="cost_radius" value="0.25"/>

    <param name="use_online" value="False"/>

    <param name="laser_max_x" value="$(var laser_max_x)"/>
    <param name="laser_min_x" value="$(var laser_min_x)"/>
    <param name="laser_max_y" value="$(var laser_max_y)"/>
    <param name="laser_min_y" value="$(var laser_min_y)"/>
    <param name="laser_max_z" value="$(var laser_max_z)"/>
    <param name="laser_min_z" value="$(var laser_min_z)"/>

    <param name="cloud_max_x" value="$(var cloud_max_x)"/>
    <param name="cloud_min_x" value="$(var cloud_min_x)"/>
    <param name="cloud_max_y" value="$(var cloud_max_y)"/>
    <param name="cloud_min_y" value="$(var cloud_min_y)"/>
    <param name="cloud_max_z" value="$(var cloud_max_z)"/>
    <param name="cloud_min_z" value="$(var cloud_min_z)"/>
  </node>-->

<!-- ===== Obstacle Detector (fast) ===== -->
<node name="obstacle_detector"
      pkg="map_augmenter"
      exec="obstacle_detector_node"
      output="screen"
      respawn="true"
      namespace="$(var namespace_nav)">

  <param name="use_namespace" value="$(var use_namespace)"/>

  <!-- Para el detector: tópicos sensores (igual que antes) -->
  <param name="laser_scan_topic" value="$(var laser_scan_topic)"/>
  <param name="point_cloud_topic" value="$(var point_cloud_topic)"/>

  <!-- IMPORTANTÍSIMO: relativo, para que caiga en /<ns>/static_map_server/map -->
  <param name="static_map_server" value="static_map_server/map"/>

  <param name="base_link_name" value="base_link"/>

  <param name="use_lidar" value="$(var use_lidar)"/>
  <param name="use_point_cloud" value="$(var use_point_cloud)"/>
  <param name="use_point_cloud2" value="false"/>

  <param name="cloud_downsampling" value="$(var cloud_downsampling)"/>
  <param name="lidar_downsampling" value="1"/>

  <!-- Detector rápido -->
  <param name="decay_factor" value="2"/>

  <!-- límites -->
  <param name="laser_max_x" value="$(var laser_max_x)"/>
  <param name="laser_min_x" value="$(var laser_min_x)"/>
  <param name="laser_max_y" value="$(var laser_max_y)"/>
  <param name="laser_min_y" value="$(var laser_min_y)"/>
  <param name="laser_max_z" value="$(var laser_max_z)"/>
  <param name="laser_min_z" value="$(var laser_min_z)"/>

  <param name="cloud_max_x" value="$(var cloud_max_x)"/>
  <param name="cloud_min_x" value="$(var cloud_min_x)"/>
  <param name="cloud_max_y" value="$(var cloud_max_y)"/>
  <param name="cloud_min_y" value="$(var cloud_min_y)"/>
  <param name="cloud_max_z" value="$(var cloud_max_z)"/>
  <param name="cloud_min_z" value="$(var cloud_min_z)"/>
</node>


<!-- ===== Map Augmenter + Merger (offline/services) ===== -->
<node name="map_augmenter"
      pkg="map_augmenter"
      exec="map_augmenter_node"
      output="screen"
      respawn="true"
      namespace="$(var namespace_nav)">

  <param name="use_namespace" value="$(var use_namespace)"/>

  <!-- Mantengo estos params aunque ya no los use para sensores, para compat con tu config -->
  <param name="laser_scan_topic" value="$(var laser_scan_topic)"/>
  <param name="point_cloud_topic" value="$(var point_cloud_topic)"/>

  <!-- IMPORTANTÍSIMO: relativos, para que caigan en /<ns>/... -->
  <param name="static_map_server" value="static_map_server/map"/>
  <param name="prohibition_map_server" value="prohibition_map_server/map"/>

  <param name="base_link_name" value="base_link"/>

  <!-- Remap igual que antes -->
  <remap from="point_obstacle" to="clicked_point"/>

  <!-- Estos flags ya no afectan detección aquí, pero los dejo por compat -->
  <param name="use_lidar" value="$(var use_lidar)"/>
  <param name="use_point_cloud" value="$(var use_point_cloud)"/>
  <param name="use_point_cloud2" value="false"/>

  <param name="cloud_downsampling" value="$(var cloud_downsampling)"/>

  <!-- Para NO doble-decay: el detector ya hace decay -->
  <param name="decay_factor" value="0"/>

  <param name="inflation_radius" value="0.10"/>
  <param name="cost_radius" value="0.25"/>

  <param name="use_online" value="False"/>

  <!-- límites (se mantienen por si tu nodo los valida) -->
  <param name="laser_max_x" value="$(var laser_max_x)"/>
  <param name="laser_min_x" value="$(var laser_min_x)"/>
  <param name="laser_max_y" value="$(var laser_max_y)"/>
  <param name="laser_min_y" value="$(var laser_min_y)"/>
  <param name="laser_max_z" value="$(var laser_max_z)"/>
  <param name="laser_min_z" value="$(var laser_min_z)"/>

  <param name="cloud_max_x" value="$(var cloud_max_x)"/>
  <param name="cloud_min_x" value="$(var cloud_min_x)"/>
  <param name="cloud_max_y" value="$(var cloud_max_y)"/>
  <param name="cloud_min_y" value="$(var cloud_min_y)"/>
  <param name="cloud_max_z" value="$(var cloud_max_z)"/>
  <param name="cloud_min_z" value="$(var cloud_min_z)"/>
</node>


  <!-- ===== Path Planner ===== -->
  <node name="path_planner"
        pkg="path_planner"
        exec="path_planner_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace" value="$(var use_namespace)"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="tf_broadcast" value="true"/>
    <param name="diagonal_paths" value="True"/>
  </node>

  <!-- ===== Simple Move ===== -->
  <node name="simple_move"
        pkg="simple_move"
        exec="simple_move_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace" value="$(var use_namespace)"/>
    <param name="max_linear_speed" value="0.8"/>
    <param name="max_angular_speed" value="0.6"/>
    <!--param name="control_alpha" value="0.2"/-->
    <param name="control_alpha" value="0.08"/>
    <!--param name="control_beta" value="0.8"/-->
    <param name="control_beta" value="0.4"/>
    <param name="move_head" value="True"/>
    <param name="use_pot_fields" value="$(var use_pot_fields)"/>
    <param name="base_link_name" value="base_link"/>
    <remap from="/cmd_vel" to="$(var cmd_vel_topic)"/>
  </node>

  <!-- ===== Potential Fields ===== -->
  <node name="potential_fields"
        pkg="potential_fields"
        exec="potential_fields_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace" value="$(var use_namespace)"/> 
    <param name="debug" value="False"/>
    <param name="show_image" value="False"/>
    <param name="use_pot_fields" value="$(var use_pot_fields)"/>

    <param name="use_lidar" value="$(var use_lidar)"/>
    <param name="use_point_cloud" value="$(var use_point_cloud)"/>

    <param name="laser_max_x" value="$(var laser_max_x)"/>
    <param name="laser_min_x" value="$(var laser_min_x)"/>
    <param name="laser_max_y" value="$(var laser_max_y)"/>
    <param name="laser_min_y" value="$(var laser_min_y)"/>
    <param name="laser_max_z" value="$(var laser_max_z)"/>
    <param name="laser_min_z" value="$(var laser_min_z)"/>

    <param name="cloud_max_x" value="$(var cloud_max_x)"/>
    <param name="cloud_min_x" value="$(var cloud_min_x)"/>
    <param name="cloud_max_y" value="$(var cloud_max_y)"/>
    <param name="cloud_min_y" value="$(var cloud_min_y)"/>
    <param name="cloud_max_z" value="$(var cloud_max_z)"/>
    <param name="cloud_min_z" value="$(var cloud_min_z)"/>

    <param name="laser_pot_fields_d0" value="0.50"/>
    <param name="laser_pot_fields_k_rej" value="0.40"/>
    <param name="cloud_pot_fields_d0" value="0.80"/>
    <param name="cloud_pot_fields_k_rej" value="0.20"/>

    <param name="cloud_downsampling" value="$(var cloud_downsampling)"/>
    <param name="cloud_points_threshold" value="$(var cloud_points_threshold)"/>
    <param name="lidar_points_threshold" value="$(var lidar_points_threshold)"/>

    <param name="point_cloud_topic" value="$(var point_cloud_topic)"/>
    <param name="laser_scan_topic" value="$(var laser_scan_topic)"/>

    <remap from="/cmd_vel" to="$(var cmd_vel_topic)"/>
    <!--remap from="/simple_move/goal_path" to="/navigation/simple_move/goal_path"/-->
  </node>

  <!-- ===== Enable Publisher ===== -->
  <node name="publish_enable"
        pkg="potential_fields"
        exec="publish_enable.py"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
      <param name="use_namespace" value="$(var use_namespace)"/>
  </node>  

  <!-- ===== Motion Planner ===== -->
  <node name="mvn_pln"
        pkg="mvn_pln"
        exec="mvn_pln_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <remap from="nav_control/goal" to="move_base_simple/goal"/>
    <param name="use_namespace" value="$(var use_namespace)"/>
    <param name="patience" value="$(var mvn_pln_patience)"/>
    <param name="base_link_name" value="base_link"/>
  </node>

</launch>
