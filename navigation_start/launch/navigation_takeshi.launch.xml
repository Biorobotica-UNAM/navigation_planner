<launch>

  <!-- ================================================================== -->
  <!--                         Global Arguments                           -->
  <!-- ================================================================== -->

  <!-- Set to true to use SLAM (no pre-built map); false uses AMCL with a pre-built map -->
  <arg name="mapless" default="false"/>

  <arg name="use_sim_time"       default="false"/>
  <arg name="namespace_hardware" default="hardware"/>
  <arg name="namespace_nav"      default="navigation"/>
  <arg name="use_namespace"      default="true"/>
  <arg name="base_link_name"     default="base_link"/>

  <!-- ===== Map files ===== -->
  <!-- static_map_file is only loaded in AMCL mode; SLAM builds its map at runtime -->
  <arg name="static_map_file"      default="$(find-pkg-share navigation_start)/maps/maps/tidbots/map.yaml"/>
  <!--arg name="prohibition_map_file" default="$(find-pkg-share navigation_start)/maps/prohibition_maps/tidbots/map.yaml"/-->
  <let name="prohibition_map_file"
     value="$(find-pkg-share navigation_start)/maps/prohibition_maps/blank/map.yaml"
     if="$(var mapless)"/>

  <let name="prohibition_map_file"
     value="$(find-pkg-share navigation_start)/maps/prohibition_maps/tidbots/map.yaml"
     unless="$(var mapless)"/>

  <!-- ===== Sensor topics ===== -->
  <arg name="point_cloud_topic"  default="/$(var namespace_hardware)/camera/points"/>
  <arg name="point_cloud_topic2" default="/$(var namespace_hardware)/camera/points"/>
  <arg name="laser_scan_topic"   default="/$(var namespace_hardware)/base/scan"/>
  <arg name="cmd_vel_topic"      default="/$(var namespace_hardware)/base/cmd_vel"/>

  <!-- ===== Sensor toggles ===== -->
  <arg name="use_lidar"        default="True"/>
  <arg name="use_point_cloud"  default="True"/>
  <arg name="use_point_cloud2" default="false"/>
  <arg name="use_pot_fields"   default="False"/>

  <!-- ===== Tuning / thresholds ===== -->
  <arg name="cloud_downsampling"     default="5"/>
  <arg name="lidar_downsampling"     default="1"/>
  <arg name="cloud_points_threshold" default="100"/>
  <arg name="lidar_points_threshold" default="20"/>
  <arg name="mvn_pln_patience"       default="True"/>

  <!-- ===== Laser detection window ===== -->
  <arg name="laser_min_x" default="0.17"/>
  <arg name="laser_max_x" default="0.55"/>
  <arg name="laser_min_y" default="-0.25"/>
  <arg name="laser_max_y" default="0.25"/>
  <arg name="laser_min_z" default="0.05"/>
  <arg name="laser_max_z" default="1.20"/>

  <!-- ===== Point cloud detection window ===== -->
  <arg name="cloud_min_x" default="0.30"/>
  <arg name="cloud_max_x" default="0.80"/>
  <arg name="cloud_min_y" default="-0.30"/>
  <arg name="cloud_max_y" default="0.30"/>
  <arg name="cloud_min_z" default="0.15"/>
  <arg name="cloud_max_z" default="1.20"/>

  <!-- ===== Map Enhancer (both modes) ===== -->
  <arg name="map_enhancer_obstacle_radius" default="0.05"/>
  <arg name="map_enhancer_debug"           default="True"/>

  <!-- ===== Map Augmenter — AMCL mode ===== -->
  <!-- use_online=False: static map is loaded once at startup and cached        -->
  <!-- obstacle_detector handles sensor detections; augmenter only merges maps  -->
  <arg name="augmenter_decay_factor"     default="0"/>
  <arg name="augmenter_inflation_radius" default="0.10"/>
  <arg name="augmenter_cost_radius"      default="0.25"/>
  <arg name="augmenter_use_online"       default="False"/>

  <!-- ===== Map Augmenter — SLAM mode ===== -->
  <!-- use_online=True: re-fetches the SLAM map on every request (map changes continuously) -->
  <!-- Higher decay and inflation because the SLAM map can have momentary noise             -->
  <arg name="slam_augmenter_decay_factor"     default="18"/>
  <arg name="slam_augmenter_inflation_radius" default="0.18"/>
  <arg name="slam_augmenter_cost_radius"      default="0.20"/>

  <!-- ===== Obstacle Detector (both modes) ===== -->
  <arg name="detector_decay_factor" default="4"/>

  <!-- ===== Path Planner ===== -->
  <!-- Diagonal paths are safe on a known static map but risky while SLAM is still building it -->
  <arg name="diagonal_paths"      default="True"/>
  <arg name="slam_diagonal_paths" default="False"/>

  <!-- ===== Simple Move — AMCL mode ===== -->
  <arg name="max_linear_speed"  default="0.9"/>
  <arg name="max_angular_speed" default="1.30"/>
  <arg name="control_alpha"     default="0.2"/>
  <arg name="control_beta"      default="0.6"/>
  <arg name="move_head"         default="True"/>

  <!-- ===== Simple Move — SLAM mode (more conservative while exploring an unknown map) ===== -->
  <arg name="slam_max_linear_speed"  default="0.8"/>
  <arg name="slam_max_angular_speed" default="1.25"/>
  <arg name="slam_control_beta"      default="0.8"/>

  <!-- ===== Potential Fields (both modes) ===== -->
  <arg name="pot_fields_debug"        default="False"/>
  <arg name="show_image"              default="False"/>
  <arg name="laser_pot_fields_d0"     default="0.50"/>
  <arg name="laser_pot_fields_k_rej"  default="0.40"/>
  <arg name="cloud_pot_fields_d0"     default="0.80"/>
  <arg name="cloud_pot_fields_k_rej"  default="0.20"/>

  <!-- ===== SLAM Toolbox (SLAM mode only) ===== -->
  <arg name="slam_map_frame"           default="map"/>
  <arg name="slam_odom_frame"          default="odom"/>
  <arg name="slam_base_frame"          default="base_footprint"/>
  <arg name="slam_resolution"          default="0.05"/>
  <arg name="slam_max_laser_range"     default="20.0"/>
  <arg name="slam_map_update_interval" default="1.0"/>


  <!-- ================================================================== -->
  <!--               Map Servers  [static: AMCL only | prohibition: both] -->
  <!-- ================================================================== -->

  <!-- Pre-built occupancy map; not started in SLAM mode (slam_toolbox provides it) -->
  <node name="static_map_server"
        pkg="nav2_map_server"
        exec="map_server"
        output="screen"
        respawn="true"
        unless="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="yaml_filename" value="$(var static_map_file)"/>
  </node>

  <!-- Prohibition map: static forbidden zones, used in both modes -->
  <node name="prohibition_map_server"
        pkg="nav2_map_server"
        exec="map_server"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="yaml_filename" value="$(var prohibition_map_file)"/>
    <remap from="map" to="fixed_prohibition_layer_map"/>
  </node>


  <!-- ================================================================== -->
  <!--                         Localization                               -->
  <!-- ================================================================== -->

  <!-- AMCL: localises against the pre-built map and broadcasts the odom→base_link TF -->
  <include file="$(find-pkg-share navigation_start)/launch/amcl_hsr.launch.xml"
           unless="$(var mapless)"/>

  <!-- SLAM Toolbox: builds the map online and broadcasts the map→odom TF -->
  <node name="slam_toolbox"
        pkg="slam_toolbox"
        exec="async_slam_toolbox_node"
        namespace="navigation"
        output="screen"
        respawn="true"
        if="$(var mapless)">
    <param name="use_sim_time"        value="$(var use_sim_time)"/>
    <param name="scan_topic"          value="$(var laser_scan_topic)"/>
    <param name="map_frame"           value="$(var slam_map_frame)"/>
    <param name="odom_frame"          value="$(var slam_odom_frame)"/>
    <param name="base_frame"          value="$(var slam_base_frame)"/>
    <param name="mode"                value="mapping"/>
    <param name="map_update_interval" value="$(var slam_map_update_interval)"/>
    <param name="resolution"          value="$(var slam_resolution)"/>
    <param name="max_laser_range"     value="$(var slam_max_laser_range)"/>

    <remap from="/map" to="map"/>
    <remap from="/map_metadata" to="map_metadata"/>
  </node>

  <!-- Lifecycle manager — AMCL mode: manages static_map_server, prohibition_map_server and amcl -->
  <node name="lifecycle_manager_map"
        pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        output="screen"
        respawn="true"
        unless="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['static_map_server', 'prohibition_map_server', 'amcl']"/>
  </node>

  <!-- Lifecycle manager — SLAM mode: manages only prohibition_map_server
       (slam_toolbox handles its own lifecycle) -->
  <node name="lifecycle_manager_map"
        pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        output="screen"
        respawn="true"
        if="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['prohibition_map_server']"/>
  </node>


  <!-- ================================================================== -->
  <!--                        Map Augmentation                            -->
  <!-- ================================================================== -->

  <!-- Augments the prohibition map in real time when a click event is received — both modes -->
  <node name="map_enhancer"
        pkg="augment_gridmap_online"
        exec="augment_gridmap_online_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <remap from="point_obstacle"             to="clicked_point"/>
    <remap from="grid_map/get_augmented_map" to="prohibition_map"/>
    <remap from="grid_map/augmented_map"     to="prohibition_layer_map"/>
    <param name="use_namespace"   value="$(var use_namespace)"/>
    <param name="obstacle_radius" value="$(var map_enhancer_obstacle_radius)"/>
    <param name="debug"           value="$(var map_enhancer_debug)"/>
    <param name="input_map"       value="fixed_prohibition_layer_map"/>
  </node>

  <!-- Map Augmenter — AMCL mode: static map cached at startup; obstacle_detector feeds detections.
       decay=0 because obstacle_detector manages its own decay independently. -->
  <node name="map_augmenter"
        pkg="map_augmenter"
        exec="map_augmenter_node"
        output="screen"
        respawn="true"
        unless="$(var mapless)"
        namespace="$(var namespace_nav)">
    <remap from="point_obstacle"         to="clicked_point"/>
    <param name="use_namespace"          value="$(var use_namespace)"/>
    <param name="static_map_server"      value="static_map_server/map"/>
    <param name="prohibition_map_server" value="prohibition_map_server/map"/>
    <param name="base_link_name"         value="$(var base_link_name)"/>
    <param name="decay_factor"           value="$(var augmenter_decay_factor)"/>
    <param name="inflation_radius"       value="$(var augmenter_inflation_radius)"/>
    <param name="cost_radius"            value="$(var augmenter_cost_radius)"/>
    <param name="use_online"             value="$(var augmenter_use_online)"/>
  </node>

  <!-- Map Augmenter — SLAM mode: use_online=True so it re-fetches the SLAM map on every
       request (the map changes continuously). obstacle_detector still runs separately. -->
  <node name="map_augmenter"
        pkg="map_augmenter"
        exec="map_augmenter_node"
        output="screen"
        respawn="true"
        if="$(var mapless)"
        namespace="$(var namespace_nav)">
    <remap from="point_obstacle"         to="clicked_point"/>
    <param name="use_namespace"          value="$(var use_namespace)"/>
    <param name="static_map_server"      value="slam_toolbox/dynamic_map"/>
    <param name="prohibition_map_server" value="prohibition_map"/>
    <param name="base_link_name"         value="$(var base_link_name)"/>
    <param name="decay_factor"           value="$(var slam_augmenter_decay_factor)"/>
    <param name="inflation_radius"       value="$(var slam_augmenter_inflation_radius)"/>
    <param name="cost_radius"            value="$(var slam_augmenter_cost_radius)"/>
    <param name="use_online"             value="True"/>
  </node>

  <!-- Obstacle Detector — AMCL mode: detects dynamic obstacles using the pre-built static map
       as a reference to distinguish walls from actual obstacles -->
  <node name="obstacle_detector"
        pkg="map_augmenter"
        exec="obstacle_detector_node"
        output="screen"
        respawn="true"
        unless="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"      value="$(var use_namespace)"/>
    <param name="laser_scan_topic"   value="$(var laser_scan_topic)"/>
    <param name="point_cloud_topic"  value="$(var point_cloud_topic)"/>
    <param name="static_map_server"  value="static_map_server/map"/>
    <param name="base_link_name"     value="$(var base_link_name)"/>
    <param name="use_lidar"          value="$(var use_lidar)"/>
    <param name="use_point_cloud"    value="$(var use_point_cloud)"/>
    <param name="use_point_cloud2"   value="$(var use_point_cloud2)"/>
    <param name="cloud_downsampling" value="$(var cloud_downsampling)"/>
    <param name="lidar_downsampling" value="$(var lidar_downsampling)"/>
    <param name="decay_factor"       value="$(var detector_decay_factor)"/>
    <param name="laser_min_x"        value="$(var laser_min_x)"/>
    <param name="laser_max_x"        value="$(var laser_max_x)"/>
    <param name="laser_min_y"        value="$(var laser_min_y)"/>
    <param name="laser_max_y"        value="$(var laser_max_y)"/>
    <param name="laser_min_z"        value="$(var laser_min_z)"/>
    <param name="laser_max_z"        value="$(var laser_max_z)"/>
    <param name="cloud_min_x"        value="$(var cloud_min_x)"/>
    <param name="cloud_max_x"        value="$(var cloud_max_x)"/>
    <param name="cloud_min_y"        value="$(var cloud_min_y)"/>
    <param name="cloud_max_y"        value="$(var cloud_max_y)"/>
    <param name="cloud_min_z"        value="$(var cloud_min_z)"/>
    <param name="cloud_max_z"        value="$(var cloud_max_z)"/>
  </node>

  <!-- Obstacle Detector — SLAM mode: same role, but uses the live SLAM map as reference
       since there is no pre-built static map to compare against -->
  <node name="obstacle_detector"
        pkg="map_augmenter"
        exec="obstacle_detector_node"
        output="screen"
        respawn="true"
        if="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"      value="$(var use_namespace)"/>
    <param name="laser_scan_topic"   value="$(var laser_scan_topic)"/>
    <param name="point_cloud_topic"  value="$(var point_cloud_topic)"/>
    <param name="static_map_server"  value="slam_toolbox/dynamic_map"/>
    <param name="base_link_name"     value="$(var base_link_name)"/>
    <param name="use_lidar"          value="$(var use_lidar)"/>
    <param name="use_point_cloud"    value="$(var use_point_cloud)"/>
    <param name="use_point_cloud2"   value="$(var use_point_cloud2)"/>
    <param name="cloud_downsampling" value="$(var cloud_downsampling)"/>
    <param name="lidar_downsampling" value="$(var lidar_downsampling)"/>
    <param name="decay_factor"       value="$(var detector_decay_factor)"/>
    <param name="laser_min_x"        value="$(var laser_min_x)"/>
    <param name="laser_max_x"        value="$(var laser_max_x)"/>
    <param name="laser_min_y"        value="$(var laser_min_y)"/>
    <param name="laser_max_y"        value="$(var laser_max_y)"/>
    <param name="laser_min_z"        value="$(var laser_min_z)"/>
    <param name="laser_max_z"        value="$(var laser_max_z)"/>
    <param name="cloud_min_x"        value="$(var cloud_min_x)"/>
    <param name="cloud_max_x"        value="$(var cloud_max_x)"/>
    <param name="cloud_min_y"        value="$(var cloud_min_y)"/>
    <param name="cloud_max_y"        value="$(var cloud_max_y)"/>
    <param name="cloud_min_z"        value="$(var cloud_min_z)"/>
    <param name="cloud_max_z"        value="$(var cloud_max_z)"/>
  </node>


  <!-- ================================================================== -->
  <!--                         Path Planning                              -->
  <!-- ================================================================== -->

  <!-- Path Planner — AMCL mode: diagonal paths safe on a known, accurate map -->
  <node name="path_planner"
        pkg="path_planner"
        exec="path_planner_node"
        output="screen"
        respawn="true"
        unless="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"  value="$(var use_namespace)"/>
    <param name="diagonal_paths" value="$(var diagonal_paths)"/>
  </node>

  <!-- Path Planner — SLAM mode: diagonal paths disabled while the map is still being built -->
  <node name="path_planner"
        pkg="path_planner"
        exec="path_planner_node"
        output="screen"
        respawn="true"
        if="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"  value="$(var use_namespace)"/>
    <param name="diagonal_paths" value="$(var slam_diagonal_paths)"/>
  </node>

  <!-- Simple Move — AMCL mode -->
  <node name="simple_move"
        pkg="simple_move"
        exec="simple_move_node"
        output="screen"
        respawn="true"
        unless="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"     value="$(var use_namespace)"/>
    <param name="max_linear_speed"  value="$(var max_linear_speed)"/>
    <param name="max_angular_speed" value="$(var max_angular_speed)"/>
    <param name="control_alpha"     value="$(var control_alpha)"/>
    <param name="control_beta"      value="$(var control_beta)"/>
    <param name="move_head"         value="$(var move_head)"/>
    <param name="use_pot_fields"    value="$(var use_pot_fields)"/>
    <param name="base_link_name"    value="$(var base_link_name)"/>
    <remap from="/cmd_vel" to="$(var cmd_vel_topic)"/>
  </node>

  <!-- Simple Move — SLAM mode: more conservative speeds while the map is being explored -->
  <node name="simple_move"
        pkg="simple_move"
        exec="simple_move_node"
        output="screen"
        respawn="true"
        if="$(var mapless)"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"     value="$(var use_namespace)"/>
    <param name="max_linear_speed"  value="$(var slam_max_linear_speed)"/>
    <param name="max_angular_speed" value="$(var slam_max_angular_speed)"/>
    <param name="control_alpha"     value="$(var control_alpha)"/>
    <param name="control_beta"      value="$(var slam_control_beta)"/>
    <param name="move_head"         value="$(var move_head)"/>
    <param name="use_pot_fields"    value="$(var use_pot_fields)"/>
    <param name="base_link_name"    value="$(var base_link_name)"/>
    <remap from="/cmd_vel" to="$(var cmd_vel_topic)"/>
  </node>

  <!-- Reactive obstacle avoidance; overrides cmd_vel when needed — both modes -->
  <node name="potential_fields"
        pkg="potential_fields"
        exec="potential_fields_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace"          value="$(var use_namespace)"/>
    <param name="debug"                  value="$(var pot_fields_debug)"/>
    <param name="show_image"             value="$(var show_image)"/>
    <param name="use_pot_fields"         value="$(var use_pot_fields)"/>
    <param name="use_lidar"              value="$(var use_lidar)"/>
    <param name="use_point_cloud"        value="$(var use_point_cloud)"/>
    <param name="laser_min_x"            value="$(var laser_min_x)"/>
    <param name="laser_max_x"            value="$(var laser_max_x)"/>
    <param name="laser_min_y"            value="$(var laser_min_y)"/>
    <param name="laser_max_y"            value="$(var laser_max_y)"/>
    <param name="laser_min_z"            value="$(var laser_min_z)"/>
    <param name="laser_max_z"            value="$(var laser_max_z)"/>
    <param name="cloud_min_x"            value="$(var cloud_min_x)"/>
    <param name="cloud_max_x"            value="$(var cloud_max_x)"/>
    <param name="cloud_min_y"            value="$(var cloud_min_y)"/>
    <param name="cloud_max_y"            value="$(var cloud_max_y)"/>
    <param name="cloud_min_z"            value="$(var cloud_min_z)"/>
    <param name="cloud_max_z"            value="$(var cloud_max_z)"/>
    <param name="laser_pot_fields_d0"    value="$(var laser_pot_fields_d0)"/>
    <param name="laser_pot_fields_k_rej" value="$(var laser_pot_fields_k_rej)"/>
    <param name="cloud_pot_fields_d0"    value="$(var cloud_pot_fields_d0)"/>
    <param name="cloud_pot_fields_k_rej" value="$(var cloud_pot_fields_k_rej)"/>
    <param name="cloud_downsampling"     value="$(var cloud_downsampling)"/>
    <param name="cloud_points_threshold" value="$(var cloud_points_threshold)"/>
    <param name="lidar_points_threshold" value="$(var lidar_points_threshold)"/>
    <param name="point_cloud_topic"      value="$(var point_cloud_topic)"/>
    <param name="laser_scan_topic"       value="$(var laser_scan_topic)"/>
    <remap from="/cmd_vel" to="$(var cmd_vel_topic)"/>
  </node>

  <!-- Publishes a latched enable/disable signal for potential fields at runtime -->
  <node name="publish_enable"
        pkg="potential_fields"
        exec="publish_enable.py"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <param name="use_namespace" value="$(var use_namespace)"/>
  </node>


  <!-- ================================================================== -->
  <!--                         Motion Planner                             -->
  <!-- ================================================================== -->

  <!-- High-level navigation FSM: sequences path_planner + simple_move to reach a goal — both modes -->
  <node name="mvn_pln"
        pkg="mvn_pln"
        exec="mvn_pln_node"
        output="screen"
        respawn="true"
        namespace="$(var namespace_nav)">
    <remap from="nav_control/goal" to="move_base_simple/goal"/>
    <param name="use_namespace"  value="$(var use_namespace)"/>
    <param name="patience"       value="$(var mvn_pln_patience)"/>
    <param name="base_link_name" value="$(var base_link_name)"/>
  </node>


  <!-- ================================================================== -->
  <!--           Navigation Interface Nodes  (no namespace)               -->
  <!-- ================================================================== -->

  <!-- Manages the known-locations database; resolves location names to poses on request -->
  <node pkg="locations_manager"
        exec="locations_manager_node"
        name="locations_manager_node"
        output="screen"/>

  <!-- High-level navigation controller; accepts goal requests and drives mvn_pln -->
  <node pkg="nav_controller"
        exec="nav_controller_node"
        name="nav_controller_node"
        output="screen"/>

</launch>
